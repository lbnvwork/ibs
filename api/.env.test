# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# CORS + JWT: в CI (без docker-compose) эти переменные не пробрасываются,
# поэтому задаём их здесь для тестового окружения (тестовые значения, не боевые).
CORS_ALLOW_ORIGIN="^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$"
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=warfarin

MAX_API_URL=test
MAX_BOT_TOKEN=test
MAX_WEBHOOK_SECRET=test-webhook-secret