###> Общие настройки приложения ###
APP_ENV=dev                # prod, dev, test
APP_DEBUG=1                # 1 для dev, 0 для prod
APP_SECRET=change_me       # замените на реальный ключ

###> База данных (PostgreSQL для Docker) ###
POSTGRES_USER=symfony
POSTGRES_PASSWORD=change_me
POSTGRES_DB=symfony
DATABASE_URL=postgresql://symfony:change_me@db:5432/symfony?serverVersion=15&charset=utf8

###> CORS ###
CORS_ALLOW_ORIGIN="^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$"

###> MAX мессенджер (интеграция уведомлений) ###
# Базовый URL API MAX, к которому MaxChannel добавляет /messages.
MAX_API_URL=https://platform-api2.max.ru
# Токен бота MAX.
MAX_BOT_TOKEN=change_me
# Секрет Webhook-подписки MAX (заголовок X-Max-Bot-Api-Secret). Нужен только для Webhook на деплое.
MAX_WEBHOOK_SECRET=change_me
# Ник бота MAX (из публичной ссылки max.ru/<ник> или GET /me → username).
MAX_BOT_NICKNAME=id463246156997_bot
###< MAX мессенджер ###

###> Docker isolation (уникальные для каждого агента) ###
COMPOSE_PROJECT_NAME=ibs_<агент>   # префикс имён контейнеров/образов/томов (напр. ibs_jul)
APP_PORT=8081                      # nginx наружу (у агентов: 8001–8005)
DB_PORT=5432                       # PostgreSQL наружу (5441–5445)
FRONTEND_PORT=5174                 # Vite dev-сервер наружу (5181–5185)
###< Docker isolation ###